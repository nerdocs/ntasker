#: src/ntasker/settings.py:383
msgid ""
"Vendor assets (Tabler/Alpine): cdn (default, jsDelivr + SRI), local (from"
" user-data dir, populate via `ntasker assets fetch`), auto (local if "
"cache complete, else cdn)."
msgstr ""
"Vendor-Assets (Tabler/Alpine): cdn (default, jsDelivr + SRI), local (aus "
"User-Data-Dir, vorher mit `ntasker assets fetch` laden), auto (local wenn"
" Cache vollständig, sonst cdn)."

#: src/ntasker/settings.py:388
msgid ""
"UI language. Leave unset for automatic (follows the browser's Accept-"
"Language header, fallback English), or pick English or German."
msgstr ""
"UI-Sprache. Leer lassen für automatisch (folgt dem Accept-Language-Header"
" des Browsers, Rückfall Englisch) oder Englisch bzw. Deutsch wählen."

#: src/ntasker/settings.py:392
msgid ""
"Default view on startup: 'list' (classic task list) or 'kanban' (4-column"
" board). The frontend remembers the last user choice in localStorage; "
"this setting drives the initial pick on a fresh browser."
msgstr ""
"Standard-Ansicht beim Start: 'list' (klassische Aufgabenliste) oder "
"'kanban' (4-Spalten-Board). Das Frontend merkt sich die letzte Auswahl im"
" localStorage; diese Einstellung greift nur beim ersten Aufruf in einem "
"frischen Browser."

#: src/ntasker/settings.py:397
msgid ""
"Base path for project names, e.g. '~/Projekte'. Discovered Claude "
"projects below it are named relative to it (the folder right under the "
"base becomes the project name) instead of relative to your home "
"directory. Unset to fall back to home-relative names. ENV: "
"NTASKER_PROJECTS_BASE."
msgstr ""
"Basispfad für Projektnamen, z. B. '~/Projekte'. Darunter gefundene "
"Claude-Projekte werden relativ dazu benannt (der Ordner direkt unterhalb "
"der Basis wird zum Projektnamen) statt relativ zu deinem Home-"
"Verzeichnis. Leer lassen, um auf Home-relative Namen zurückzufallen. ENV:"
" NTASKER_PROJECTS_BASE."

#: src/ntasker/settings.py:404
msgid ""
"Start directory for a run whose task has no project (or whose project "
"directory does not exist and cannot be created), e.g. '~/Projekte'. Unset"
" falls back to the projects base, then to your home directory -- note "
"that Claude Code refuses to work in the home directory until you answer "
"its trust prompt. ENV: NTASKER_NO_PROJECT_DIR."
msgstr ""

#: src/ntasker/settings.py:411
msgid ""
"Default AI coding agent for new tasks (and the fallback for any task "
"without an explicit agent): claude, opencode or pi. ENV: "
"NTASKER_DEFAULT_AGENT."
msgstr ""

#: src/ntasker/settings.py:416
msgid ""
"Run spawned OpenCode sessions with --auto (auto-approve actions). Yes/no,"
" default no."
msgstr ""

#: src/ntasker/settings.py:420
msgid ""
"Seed spawned sessions with the task data inlined into the initial prompt "
"instead of the /task command. Skips the loader roundtrip -- much faster "
"time-to-first-response with slow local models (Ollama). Yes/no, default "
"no. ENV: NTASKER_COMPACT_SEED."
msgstr ""
"Gestartete Sessions mit den Task-Daten direkt im Start-Prompt seeden "
"statt mit dem /task-Kommando. Spart den Loader-Umweg -- deutlich "
"schnellere erste Antwort bei langsamen lokalen Modellen (Ollama). "
"Ja/Nein, Standard Nein. ENV: NTASKER_COMPACT_SEED."

#: src/ntasker/settings.py:426
msgid ""
"Permission mode for interactive Claude sessions: 'default' (normal -- "
"Claude asks first), 'auto' (auto-accept actions), 'plan' (plan only, no "
"changes), or 'bypassPermissions' (skip every prompt -- dangerous). Passed"
" to the CLI as --permission-mode. Default: default."
msgstr ""
"Berechtigungsmodus für interaktive Claude-Sitzungen: 'default' (normal --"
" Claude fragt zuerst), 'auto' (Aktionen automatisch bestätigen), 'plan' "
"(nur planen, keine Änderungen) oder 'bypassPermissions' (jede Abfrage "
"überspringen -- gefährlich). Wird als --permission-mode an die CLI "
"übergeben. Standard: default."

#: src/ntasker/settings.py:432
msgid ""
"When starting a Claude session (Create + Run or the per-task run button),"
" open the terminal immediately (true, default) or start it in the "
"background and stay on the board (false). ENV: "
"NTASKER_CLAUDE_OPEN_TERMINAL."
msgstr ""

#: src/ntasker/settings.py:438
msgid ""
"How many seconds a live Claude session may stay silent before ntasker "
"treats it as waiting for your input (the CLI sends no explicit 'I have a "
"question' signal). Lower = quicker 'waiting' badge but more false "
"positives; higher = fewer false positives but slower. Default 8."
msgstr ""
"Wie viele Sekunden eine laufende Claude-Sitzung still sein darf, bevor "
"ntasker sie als 'wartet auf Eingabe' behandelt (die CLI sendet kein "
"explizites 'Ich habe eine Frage'-Signal). Niedriger = schnelleres "
"'wartet'-Abzeichen, aber mehr Fehlalarme; höher = weniger Fehlalarme, "
"aber träger. Standard 8."

#: src/ntasker/settings.py:444
msgid ""
"Shell command run by 'self-update' to upgrade ntasker (e.g. `uv tool "
"upgrade ntasker`). Unset to auto-detect how ntasker was installed."
msgstr ""
"Shell-Befehl, den 'self-update' zum Aktualisieren von ntasker ausführt "
"(z. B. `uv tool upgrade ntasker`). Leer lassen, um die Installationsart "
"automatisch zu erkennen."

#: src/ntasker/settings.py:449
msgid ""
"Directory holding your Claude Code skills, shown on the Workspace page "
"with a load/broken verdict per skill. Defaults to ~/.claude/skills when "
"unset."
msgstr ""
"Verzeichnis mit deinen Claude-Code-Skills. Die Arbeitsumgebung zeigt pro "
"Skill an, ob er lädt oder defekt ist. Ohne Angabe gilt ~/.claude/skills."

#: src/ntasker/settings.py:454
msgid ""
"Root of your Markdown knowledge base (e.g. an Obsidian vault). The "
"Workspace page lists its areas with note counts and links straight into "
"Obsidian. Unset hides the card."
msgstr ""
"Wurzel deiner Markdown-Wissensdatenbank (z. B. ein Obsidian-Vault). Die "
"Arbeitsumgebung listet die Bereiche mit Notiz-Zahlen und verlinkt direkt "
"nach Obsidian. Ohne Angabe bleibt die Karte ausgeblendet."

#: src/ntasker/settings.py:459
msgid ""
"Directory of agent-persona Markdown files (one file per persona, its role"
" in front matter or as a bold 'Role:' line). Unset hides the card."
msgstr ""
"Verzeichnis mit Agent-Persona-Dateien (eine Markdown-Datei je Persona, "
"die Rolle im Front Matter oder als fette 'Rolle:'-Zeile). Ohne Angabe "
"bleibt die Karte ausgeblendet."

#: src/ntasker/settings.py:464
msgid ""
"Output folder for generated documents (offers, reviews, exports). The "
"Workspace page lists them newest-first and previews Markdown, text and "
"CSV files in place. Unset hides the card."
msgstr ""
"Ablageordner für generierte Dokumente (Angebote, Reviews, Exporte). Die "
"Arbeitsumgebung listet sie neueste zuerst und zeigt Markdown-, Text- und "
"CSV-Dateien direkt in der Vorschau. Ohne Angabe bleibt die Karte "
"ausgeblendet."

#: src/ntasker/settings.py:469
msgid ""
"Name of the HTTP MCP server in ~/.claude.json that serves your JCBrain "
"(OpenBrain) notes; its URL and auth header are reused, no second key to "
"maintain. Notes found there can be attached to tasks as context and are "
"handed to the agent in full. Default: open-brain."
msgstr ""
"Name des HTTP-MCP-Servers in ~/.claude.json, der deine "
"JCBrain-(OpenBrain-)Notizen liefert; URL und Auth-Header werden "
"wiederverwendet, kein zweiter Schlüssel nötig. Dort gefundene Notizen "
"lassen sich als Kontext an Aufgaben anhängen und werden dem Agenten "
"vollständig übergeben. Standard: open-brain."

