#: src/ntasker/settings.py:343
msgid ""
"Vendor assets (Tabler/Alpine): cdn (default, jsDelivr + SRI), local (from"
" user-data dir, populate via `ntasker assets fetch`), auto (local if "
"cache complete, else cdn)."
msgstr ""

#: src/ntasker/settings.py:348
msgid ""
"UI language. Leave unset for automatic (follows the browser's Accept-"
"Language header, fallback English), or pick English or German."
msgstr ""

#: src/ntasker/settings.py:352
msgid ""
"Default view on startup: 'list' (classic task list) or 'kanban' (4-column"
" board). The frontend remembers the last user choice in localStorage; "
"this setting drives the initial pick on a fresh browser."
msgstr ""

#: src/ntasker/settings.py:357
msgid ""
"Base path for project names, e.g. '~/Projekte'. Discovered Claude "
"projects below it are named relative to it (the folder right under the "
"base becomes the project name) instead of relative to your home "
"directory. Unset to fall back to home-relative names. ENV: "
"NTASKER_PROJECTS_BASE."
msgstr ""

#: src/ntasker/settings.py:364
msgid ""
"Start directory for a run whose task has no project (or whose project "
"directory does not exist and cannot be created), e.g. '~/Projekte'. Unset"
" falls back to the projects base, then to your home directory -- note "
"that Claude Code refuses to work in the home directory until you answer "
"its trust prompt. ENV: NTASKER_NO_PROJECT_DIR."
msgstr ""

#: src/ntasker/settings.py:371
msgid ""
"Default AI coding agent for new tasks (and the fallback for any task "
"without an explicit agent): claude, opencode or pi. ENV: "
"NTASKER_DEFAULT_AGENT."
msgstr ""

#: src/ntasker/settings.py:376
msgid ""
"Seed spawned sessions with the task data inlined into the initial prompt "
"instead of the /task command. Skips the loader roundtrip -- much faster "
"time-to-first-response with slow local models (Ollama). Yes/no, default "
"no. ENV: NTASKER_COMPACT_SEED."
msgstr ""

#: src/ntasker/settings.py:382
msgid ""
"When starting a Claude session (Create + Run or the per-task run button),"
" open the terminal immediately (true, default) or start it in the "
"background and stay on the board (false). ENV: "
"NTASKER_CLAUDE_OPEN_TERMINAL."
msgstr ""

#: src/ntasker/settings.py:388
msgid ""
"How many seconds a live Claude session may stay silent before ntasker "
"treats it as waiting for your input (the CLI sends no explicit 'I have a "
"question' signal). Lower = quicker 'waiting' badge but more false "
"positives; higher = fewer false positives but slower. Default 8."
msgstr ""

#: src/ntasker/settings.py:394
msgid ""
"Whether the task queue works through its tasks on its own. Off by default"
" -- queued tasks wait until you press Start on the queue panel. One task "
"runs per project at a time; a task leaves the queue as soon as its "
"session ends. ENV: NTASKER_QUEUE_ENABLED."
msgstr ""

#: src/ntasker/settings.py:400
msgid ""
"Shell command run by 'self-update' to upgrade ntasker (e.g. `uv tool "
"upgrade ntasker`). Unset to auto-detect how ntasker was installed."
msgstr ""

#: src/ntasker/settings.py:405
msgid ""
"JSON array of plugins switched off, e.g. [\"pi\", \"workspace\"]. Toggle "
"them on the Plugins card above; at least one agent plugin stays enabled. "
"ENV: NTASKER_PLUGINS_DISABLED (comma-separated)."
msgstr ""

