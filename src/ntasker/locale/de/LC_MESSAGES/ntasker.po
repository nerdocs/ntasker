msgid "Restore the default priority order (discards manual drag order)"
msgstr ""
"Standard-Sortierung nach Priorität wiederherstellen (verwirft die "
"manuelle Reihenfolge)"

#: src/ntasker/app.py:535 src/ntasker/app.py:854
#: src/ntasker/templates/index.html:1591
msgid "Done"
msgstr "Erledigt"

#: src/ntasker/app.py:536
msgid "(empty)"
msgstr "(leer)"

#: src/ntasker/app.py:537
msgid "Drag to reorder"
msgstr "Zum Sortieren ziehen"

#: src/ntasker/app.py:538
msgid "Expand done column"
msgstr "Spalte 'Erledigt' ausklappen"

#: src/ntasker/app.py:539
msgid "Collapse done column"
msgstr "Spalte 'Erledigt' einklappen"

#: src/ntasker/app.py:541 src/ntasker/templates/settings.html:317
msgid "Queue"
msgstr "Queue"

#: src/ntasker/app.py:542
msgid "Resume queue"
msgstr "Queue fortsetzen"

#: src/ntasker/app.py:543
msgid "Pause queue"
msgstr "Queue pausieren"

#: src/ntasker/app.py:545
msgid "Resume: start the next task per project as soon as its lane is free."
msgstr ""
"Fortsetzen: pro Projekt die nächste Aufgabe starten, sobald ihre Spur "
"frei ist."

#: src/ntasker/app.py:548
msgid "Stop starting new tasks. A task already running keeps going."
msgstr ""
"Keine neuen Aufgaben mehr starten. Eine bereits laufende Aufgabe läuft "
"weiter."

#: src/ntasker/app.py:550
msgid "Empty. Press a task's run button or drop a card here to queue it."
msgstr ""
"Leer. Der Run-Button einer Aufgabe oder eine hierher gezogene Karte reiht"
" sie ein."

#: src/ntasker/app.py:551
msgid "Plan queue"
msgstr "Queue planen"

#: src/ntasker/app.py:553
msgid ""
"Pick tasks, then let an agent plan them: it records how they depend on "
"each other, sets the run order and starts the queue. It plans only -- the"
" queue does the work."
msgstr ""
"Tasks anhaken, dann einen Agenten planen lassen: Er hält fest, wie sie "
"voneinander abhängen, legt die Reihenfolge fest und startet die Queue. Er"
" plant nur -- gearbeitet wird in der Queue."

#: src/ntasker/app.py:557
msgid "Tick the tasks the planner should order"
msgstr "Tasks anhaken, die der Planer reihen soll"

#: src/ntasker/app.py:558
#, python-brace-format
msgid "Plan {n} selected"
msgstr "{n} ausgewählte planen"

#: src/ntasker/app.py:559
msgid "Queue planner started -- watch it in its session."
msgstr "Queue-Planer gestartet -- in seiner Session mitlesen."

#: src/ntasker/app.py:560 src/ntasker/app.py:996
msgid "Run"
msgstr "Ausführen"

#: src/ntasker/app.py:561
msgid "Start now -- do not wait for the project to be free"
msgstr "Jetzt starten -- nicht warten, bis das Projekt frei ist"

#: src/ntasker/app.py:562
#, python-brace-format
msgid "Task #{id} starts now, next to what is already running."
msgstr "Aufgabe #{id} startet jetzt, neben dem, was schon läuft."

#: src/ntasker/app.py:563
#, python-brace-format
msgid "Task #{id} queued -- it starts as soon as its project is free."
msgstr "Aufgabe #{id} eingereiht -- sie startet, sobald ihr Projekt frei ist."

#: src/ntasker/app.py:564
msgid "Paused -- press Resume to work through these."
msgstr "Pausiert -- auf „Queue fortsetzen“ drücken, um sie abzuarbeiten."

#: src/ntasker/app.py:565
msgid "Running one task per project, top down."
msgstr "Läuft: eine Aufgabe pro Projekt, von oben nach unten."

#: src/ntasker/app.py:566
#, python-brace-format
msgid "Position {n} in the queue"
msgstr "Position {n} in der Queue"

#: src/ntasker/app.py:567
msgid "Remove from queue"
msgstr "Aus der Queue entfernen"

#: src/ntasker/app.py:568
#, python-brace-format
msgid "Queued at position {n}"
msgstr "In der Queue an Position {n}"

#: src/ntasker/app.py:569
msgid "Skipped while a dependency is still open."
msgstr "Wird übersprungen, solange eine Abhängigkeit noch offen ist."

#: src/ntasker/app.py:570
msgid "Skipped -- this task's agent is not installed."
msgstr "Wird übersprungen -- der Agent dieser Aufgabe ist nicht installiert."

#: src/ntasker/app.py:572
msgid ""
"Session ended before the task was done -- check the task, then remove it,"
" run it again or resume its session."
msgstr ""
"Sitzung vor Abschluss der Aufgabe beendet -- Aufgabe prüfen, dann "
"entfernen, erneut starten oder Sitzung fortsetzen."

#: src/ntasker/app.py:575
msgid "ended"
msgstr "beendet"

#: src/ntasker/app.py:576
msgid "Waiting -- another task's session holds one of its directories."
msgstr ""
"Wartet -- die Session einer anderen Aufgabe hält eines ihrer "
"Verzeichnisse."

#: src/ntasker/app.py:577
msgid "Waiting -- a directory it holds has uncommitted changes."
msgstr "Wartet -- ein gehaltenes Verzeichnis hat nicht committete Änderungen."

#: src/ntasker/app.py:578
msgid "Waiting -- the usage limit resets at"
msgstr "Wartet -- das Nutzungslimit endet um"

#: src/ntasker/app.py:580 src/ntasker/templates/index.html:1054
#: src/ntasker/templates/index.html:2439
msgid "Also locks"
msgstr "Sperrt zusätzlich"

#: src/ntasker/app.py:581
msgid "project name, Enter"
msgstr "Projektname, Enter"

#: src/ntasker/app.py:582
msgid "Remove lock"
msgstr "Sperre entfernen"

#: src/ntasker/app.py:583
msgid "Also locks the directories of:"
msgstr "Sperrt zusätzlich die Verzeichnisse von:"

#: src/ntasker/app.py:584
msgid "Draft -- never started. Untick Draft to run it."
msgstr "Entwurf -- wird nie gestartet. Entwurf abwählen, um ihn zu starten."

#: src/ntasker/app.py:585
msgid "Draft: never started by anyone"
msgstr "Entwurf: wird von niemandem gestartet"

#: src/ntasker/app.py:586
msgid "Fasttrack: the agent commits and finishes the task itself"
msgstr "Fasttrack: der Agent committet und schließt die Aufgabe selbst ab"

#: src/ntasker/app.py:587
msgid "Paused until"
msgstr "Pausiert bis"

#: src/ntasker/app.py:588
msgid ""
"A usage limit stopped the session -- nTasker continues it once the limit "
"has reset"
msgstr ""
"Ein Nutzungslimit hat die Session gestoppt -- nTasker setzt sie fort, "
"sobald das Limit zurückgesetzt ist"

#: src/ntasker/app.py:589
msgid "A failed fasttrack run leaves the queue instead of blocking it"
msgstr ""
"Ein fehlgeschlagener Fasttrack-Lauf verlässt die Queue, statt sie zu "
"blockieren"

#: src/ntasker/app.py:590
msgid "Mark as fasttrack"
msgstr "Als Fasttrack markieren"

#: src/ntasker/app.py:591
msgid "Remove fasttrack"
msgstr "Fasttrack entfernen"

#: src/ntasker/app.py:593
msgid "Runs in this git worktree, in parallel to the project's other runs"
msgstr "Läuft in diesem Git-Worktree, parallel zu den anderen Läufen des Projekts"

#: src/ntasker/app.py:594
msgid "New worktree"
msgstr "Neuer Worktree"

#: src/ntasker/app.py:595
msgid ""
"Run this task in a git worktree on its own branch, in parallel to other "
"runs"
msgstr ""
"Diese Aufgabe in einem Git-Worktree auf eigenem Branch ausführen, "
"parallel zu anderen Läufen"

#: src/ntasker/app.py:596
#, python-brace-format
msgid "Join {branch} ({tasks})"
msgstr "{branch} beitreten ({tasks})"

#: src/ntasker/app.py:597
msgid "Leave worktree"
msgstr "Worktree verlassen"

#: src/ntasker/app.py:598
msgid "Decide worktree"
msgstr "Über Worktree entscheiden"

#: src/ntasker/app.py:599
msgid "Worktrees"
msgstr "Worktrees"

#: src/ntasker/app.py:600
msgid "Git worktrees -- a finished one waits for your decision"
msgstr "Git-Worktrees -- ein fertiger wartet auf deine Entscheidung"

#: src/ntasker/app.py:601
msgid "decision pending"
msgstr "Entscheidung offen"

#: src/ntasker/app.py:602
msgid "in use"
msgstr "in Verwendung"

#: src/ntasker/app.py:603
msgid "kept"
msgstr "behalten"

#: src/ntasker/app.py:604
#, python-brace-format
msgid "merging in #{id}"
msgstr "wird in #{id} gemergt"

#: src/ntasker/app.py:605
msgid "being discarded"
msgstr "wird verworfen"

#: src/ntasker/app.py:606 src/ntasker/cli.py:136
msgid "Worktree"
msgstr "Worktree"

#: src/ntasker/app.py:607
#, python-brace-format
msgid "{project} -- {commits} commit(s) on top of {base}"
msgstr "{project} -- {commits} Commit(s) auf {base}"

#: src/ntasker/app.py:608
msgid ""
"Uncommitted changes in the worktree -- discard drops them, merge hands "
"them to an agent"
msgstr ""
"Nicht committete Änderungen im Worktree -- Verwerfen löscht sie, Mergen "
"übergibt sie einem Agenten"

#: src/ntasker/app.py:609
msgid "Merge and remove"
msgstr "Mergen und entfernen"

#: src/ntasker/app.py:610
msgid "Merge into the project; if that is not clean, an agent run does it"
msgstr "Ins Projekt mergen; geht das nicht sauber, erledigt es ein Agent-Lauf"

#: src/ntasker/app.py:611
msgid "Keep for now"
msgstr "Vorerst behalten"

#: src/ntasker/app.py:612
msgid "For rework or a follow-up task that joins this worktree"
msgstr "Für Nacharbeit oder eine Folgeaufgabe, die diesem Worktree beitritt"

#: src/ntasker/app.py:613 src/ntasker/app.py:640
msgid "Discard"
msgstr "Verwerfen"

#: src/ntasker/app.py:614
#, python-brace-format
msgid "{branch} merged and removed"
msgstr "{branch} gemergt und entfernt"

#: src/ntasker/app.py:615
#, python-brace-format
msgid "{branch} kept"
msgstr "{branch} behalten"

#: src/ntasker/app.py:616
#, python-brace-format
msgid "{branch} needs an agent to merge -- task #{id} queued"
msgstr "{branch} braucht einen Agenten zum Mergen -- Aufgabe #{id} eingereiht"

#: src/ntasker/app.py:617
#, python-brace-format
msgid "{branch} will be discarded"
msgstr "{branch} wird verworfen"

#: src/ntasker/app.py:618 src/ntasker/templates/index.html:1105
msgid "Park as a draft"
msgstr "Als Entwurf parken"

#: src/ntasker/app.py:619
msgid "Unpark draft"
msgstr "Entwurf freigeben"

#: src/ntasker/app.py:620
msgid "Run log"
msgstr "Run-Log"

#: src/ntasker/app.py:621
msgid "Acknowledge and remove"
msgstr "Bestätigen und entfernen"

#: src/ntasker/app.py:622
msgid "Finished"
msgstr "Fertig"

#: src/ntasker/app.py:623
msgid "Failed"
msgstr "Fehlgeschlagen"

#: src/ntasker/app.py:624 src/ntasker/app.py:816
msgid "Blocked"
msgstr "Blockiert"

#: src/ntasker/app.py:625
msgid "Session ended without a result"
msgstr "Session ohne Ergebnis beendet"

#: src/ntasker/app.py:626
msgid "Paused by the usage limit -- continues after the reset"
msgstr "Wegen Nutzungslimit pausiert -- geht nach dem Reset weiter"

#: src/ntasker/app.py:627
msgid "Create a task from this suggestion"
msgstr "Aufgabe aus diesem Vorschlag anlegen"

#: src/ntasker/app.py:628
#, python-brace-format
msgid "Follow-up of #{id} {title}"
msgstr "Folgeaufgabe von #{id} {title}"

#: src/ntasker/app.py:630
msgid "Drop an idea -- \"project: ...\" picks the project -- Ctrl+K"
msgstr "Idee ablegen -- \"projekt: ...\" wählt das Projekt -- Strg+K"

#: src/ntasker/app.py:631
msgid "Stored -- the inbox triages it"
msgstr "Gespeichert -- die Inbox sortiert sie ein"

#: src/ntasker/app.py:632
msgid "Could not store the note"
msgstr "Notiz konnte nicht gespeichert werden"

#: src/ntasker/app.py:633
msgid "Answer or correction -- Enter re-triages"
msgstr "Antwort oder Korrektur -- Enter triagiert neu"

#: src/ntasker/app.py:634
msgid "Re-triaging with your answer..."
msgstr "Wird mit deiner Antwort neu triagiert ..."

#: src/ntasker/app.py:635
msgid "Triaging..."
msgstr "Wird einsortiert …"

#: src/ntasker/app.py:636
msgid "Triage failed"
msgstr "Einsortieren fehlgeschlagen"

#: src/ntasker/app.py:637
msgid "Retry"
msgstr "Erneut versuchen"

#: src/ntasker/app.py:638
msgid "Accept"
msgstr "Annehmen"

#: src/ntasker/app.py:639
msgid "Accept + Run"
msgstr "Annehmen + Starten"

#: src/ntasker/app.py:642
msgid ""
"Tick the projects the task touches: the first is its project, the rest "
"become directory locks. None ticked = cross-project."
msgstr ""
"Hake die Projekte an, die die Aufgabe berührt: das erste wird ihr "
"Projekt, die weiteren Directory-Locks. Nichts angehakt = "
"projektübergreifend."

#: src/ntasker/app.py:646
msgid "Confidence"
msgstr "Sicherheit"

#: src/ntasker/app.py:647
#, python-brace-format
msgid "Learning the projects: {done} of {total} summarised"
msgstr "Projekte werden erfasst: {done} von {total} zusammengefasst"

#: src/ntasker/app.py:649
msgid ""
"The triage works already; projects without a summary are only offered by "
"name."
msgstr ""
"Die Triage arbeitet bereits; Projekte ohne Zusammenfassung werden nur mit"
" ihrem Namen angeboten."

#: src/ntasker/app.py:651
msgid "Generated prompt"
msgstr "Erzeugter Prompt"

#: src/ntasker/app.py:652
msgid "Summary..."
msgstr "Zusammenfassung …"

#: src/ntasker/app.py:653
msgid "What the inbox triage knows about this project"
msgstr "Was die Inbox über dieses Projekt weiß"

#: src/ntasker/app.py:654
msgid "One paragraph: what this project is and what belongs to it"
msgstr "Ein Absatz: was dieses Projekt ist und was dazugehört"

#: src/ntasker/app.py:655
msgid "Regenerate"
msgstr "Neu erzeugen"

#: src/ntasker/app.py:656
msgid "Could not generate the summary"
msgstr "Zusammenfassung konnte nicht erzeugt werden"

#: src/ntasker/app.py:659
msgid "Show report"
msgstr "Bericht anzeigen"

#: src/ntasker/app.py:660 src/ntasker/app.py:709
msgid "Report"
msgstr "Bericht"

#: src/ntasker/app.py:661
msgid "No report yet."
msgstr "Noch kein Bericht."

#: src/ntasker/app.py:662
#, python-brace-format
msgid "Written {when}"
msgstr "Geschrieben {when}"

#: src/ntasker/app.py:663 src/ntasker/app.py:1007
msgid "Resume session"
msgstr "Session fortsetzen"

#: src/ntasker/app.py:665
msgid "Show me what you do"
msgstr "Zeig mir, was du tust"

#: src/ntasker/app.py:666
msgid "Open the live terminal of this run"
msgstr "Das Live-Terminal dieses Laufs öffnen"

#: src/ntasker/app.py:667
msgid "Conversation"
msgstr "Verlauf"

#: src/ntasker/app.py:668
msgid "Show the conversation"
msgstr "Den Verlauf anzeigen"

#: src/ntasker/app.py:669
msgid "Split"
msgstr "Geteilt"

#: src/ntasker/app.py:670
msgid "Conversation and terminal side by side"
msgstr "Verlauf und Terminal nebeneinander"

#: src/ntasker/app.py:671
msgid "Prompt"
msgstr "Prompt"

#: src/ntasker/app.py:672
msgid "Answer"
msgstr "Antwort"

#: src/ntasker/app.py:673
#, python-brace-format
msgid "Steps: {n}"
msgstr "Schritte: {n}"

#: src/ntasker/app.py:674
msgid "Working ..."
msgstr "Arbeitet ..."

#: src/ntasker/app.py:675
msgid "Interrupt"
msgstr "Unterbrechen"

#: src/ntasker/app.py:676
msgid "Interrupt the agent (Esc)"
msgstr "Agent unterbrechen (Esc)"

#: src/ntasker/app.py:677
msgid "Waiting for your next instruction."
msgstr "Wartet auf deine nächste Anweisung."

#: src/ntasker/app.py:678
