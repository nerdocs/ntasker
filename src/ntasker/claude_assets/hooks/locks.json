{
  "statusLine": {"type": "command", "command": "ntasker hook statusline"},
  "hooks": {
    "SessionStart": [
      {"matcher": "clear", "hooks": [{"type": "command", "command": "ntasker hook clear"}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "ntasker hook waiting"}]}
    ],
    "StopFailure": [
      {"matcher": "rate_limit", "hooks": [{"type": "command", "command": "ntasker hook limit"}]}
    ],
    "Notification": [
      {"matcher": "permission_prompt", "hooks": [{"type": "command", "command": "ntasker hook waiting"}]}
    ],
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "ntasker hook running"}]}
    ],
    "PostToolUse": [
      {"hooks": [{"type": "command", "command": "ntasker hook running"}]}
    ],
    "PreToolUse": [
      {"matcher": "AskUserQuestion", "hooks": [{"type": "command", "command": "ntasker hook ask"}]},
      {"matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash", "hooks": [{"type": "command", "command": "ntasker hook pretooluse"}]}
    ]
  }
}
